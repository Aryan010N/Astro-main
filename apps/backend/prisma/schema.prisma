generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER          @map("user")
  EXPERT        @map("expert")
  ADMIN         @map("admin")
  SUPPORT_AGENT @map("support_agent")

  @@map("user_role")
}

enum KycStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("kyc_status")
}

enum TransactionType {
  RECHARGE           @map("recharge")
  SESSION_CHARGE     @map("session_charge")
  SESSION_REFUND     @map("session_refund")
  COMMISSION_EARNING @map("commission_earning")
  PAYOUT             @map("payout")
  MANUAL_ADJUSTMENT  @map("manual_adjustment")

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING  @map("pending")
  SUCCESS  @map("success")
  FAILED   @map("failed")
  REVERSED @map("reversed")

  @@map("transaction_status")
}

enum PaymentOrderStatus {
  CREATED   @map("created")
  ATTEMPTED @map("attempted")
  PAID      @map("paid")
  FAILED    @map("failed")

  @@map("payment_order_status")
}

enum SessionStatus {
  REQUESTED
  ACCEPTED
  CANCELLED
  CONNECTING
  ACTIVE
  RECONNECTING
  ENDED
  FORCE_ENDED
  BILLED
  SUMMARY_SHOWN

  @@map("session_status")
}

enum SessionType {
  CHAT
  AUDIO
  VIDEO

  @@map("session_type")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phoneNumber  String    @unique @map("phone_number")
  email        String?   @unique @map("email")
  passwordHash String?   @map("password_hash")
  role         UserRole  @default(USER)
  name         String?   @map("name")
  dateOfBirth  DateTime? @map("date_of_birth")
  timeOfBirth  String?   @map("time_of_birth")
  placeOfBirth String?   @map("place_of_birth")
  gender       String?   @map("gender")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  wallet        Wallet?
  paymentOrders PaymentOrder[]
  expertProfile ExpertProfile?
  refreshTokens RefreshToken[]
  userSessions  ConsultationSession[] @relation("UserSessions")

  @@map("users")
}

model ExpertProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @unique @map("user_id") @db.Uuid
  name               String                @map("name")
  email              String?               @map("email")
  bio                String?               @map("bio")
  experienceYears    Int                   @default(0) @map("experience_years")
  languages          String[]              @default([]) @map("languages")
  expertise          String[]              @default([]) @map("expertise")
  idProofType        String?               @map("id_proof_type")
  idProofNumber      String?               @map("id_proof_number")
  idProofUrl         String?               @map("id_proof_url")
  payoutUpiId        String?               @map("payout_upi_id")
  chatRateInPaise    BigInt                @default(0) @map("chat_rate_in_paise")
  callRateInPaise    BigInt                @default(0) @map("call_rate_in_paise")
  videoRateInPaise   BigInt                @default(0) @map("video_rate_in_paise")
  kycStatus          KycStatus             @default(PENDING) @map("kyc_status")
  rejectionReason    String?               @map("rejection_reason")
  isLive             Boolean               @default(false) @map("is_live")
  totalConsultations Int                   @default(0) @map("total_consultations")
  rating             Float                 @default(5.0) @map("rating")
  missedRequests     Int                   @default(0) @map("missed_requests")
  averageResponseSec Float                 @default(0.0) @map("average_response_sec")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertSessions ConsultationSession[] @relation("ExpertSessions")

  @@index([kycStatus])
  @@map("expert_profiles")
}

model ConsultationSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  expertId         String        @map("expert_id") @db.Uuid
  sessionType      SessionType   @default(CHAT) @map("session_type")
  status           SessionStatus @default(REQUESTED) @map("status")
  rateInPaise      BigInt        @map("rate_in_paise")
  durationSeconds  Int           @default(0) @map("duration_seconds")
  totalBilledPaise BigInt        @default(0) @map("total_billed_paise")
  requestedAt      DateTime      @default(now()) @map("requested_at")
  acceptedAt       DateTime?     @map("accepted_at")
  startedAt        DateTime?     @map("started_at")
  endedAt          DateTime?     @map("ended_at")
  rejectionReason  String?       @map("rejection_reason")
  endReason        String?       @map("end_reason")
  metadata         Json?         @map("metadata")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user     User             @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  expert   ExpertProfile    @relation("ExpertSessions", fields: [expertId], references: [id], onDelete: Cascade)
  messages SessionMessage[]

  @@index([userId, status])
  @@index([expertId, status])
  @@map("consultation_sessions")
}

model SessionMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  senderRole String   @map("sender_role")
  text       String   @map("text")
  createdAt  DateTime @default(now()) @map("created_at")

  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("session_messages")
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  balanceInPaise BigInt   @default(0) @map("balance_in_paise")
  currency       String   @default("INR") @map("currency")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletLedgerEntry[]

  @@map("wallets")
}

model WalletLedgerEntry {
  id                     String            @id @default(uuid()) @db.Uuid
  walletId               String            @map("wallet_id") @db.Uuid
  amountInPaise          BigInt            @map("amount_in_paise")
  type                   TransactionType   @map("type")
  status                 TransactionStatus @default(PENDING) @map("status")
  runningBalanceSnapshot BigInt            @map("running_balance_snapshot")
  referenceId            String?           @map("reference_id")
  idempotencyKey         String?           @unique @map("idempotency_key")
  description            String?           @map("description")
  metadata               Json?             @map("metadata")
  createdAt              DateTime          @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@map("wallet_ledger")
}

model PaymentOrder {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  orderId       String             @unique @map("order_id")
  amountInPaise BigInt             @map("amount_in_paise")
  currency      String             @default("INR") @map("currency")
  receipt       String             @map("receipt")
  status        PaymentOrderStatus @default(CREATED) @map("status")
  paymentId     String?            @map("payment_id")
  signature     String?            @map("signature")
  notes         Json?              @map("notes")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payment_orders")
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id")
  eventType String   @map("event_type")
  payload   Json     @map("payload")
  status    String   @default("PROCESSED") @map("status")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@map("payment_webhook_events")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @map("token")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false) @map("revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
